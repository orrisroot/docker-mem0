# ==============================================================================
# Mem0 Self-Hosted Configuration (.env)
# NOTE: All secrets must be stored here and NOT committed to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL with pgvector)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_COLLECTION_NAME=memories
APP_DB_NAME=mem0_app

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=your_secure_jwt_secret_here
ADMIN_API_KEY=
AUTH_DISABLED=false

# ------------------------------------------------------------------------------
# 3. Ports, URLs & Subpath Routing
# ------------------------------------------------------------------------------
INSTANCE_NAME=Mem0

# --- Standard Direct / Local Setup (Default) ---
# API_PORT=8888
# API_SUBPATH=
# API_URL=http://localhost:8888
#
# DASHBOARD_PORT=3000
# DASHBOARD_SUBPATH=
# DASHBOARD_URL=http://localhost:3000

# --- Production Subpath Reverse Proxy Setup (Apache with /mem0/api & /mem0/ui) ---
# When deploying behind Apache reverse proxy on https://your-domain.example.com
API_PORT=8888
API_SUBPATH=/mem0/api
API_URL=http://localhost:8888/mem0/api

DASHBOARD_PORT=3000
DASHBOARD_SUBPATH=/mem0/ui
DASHBOARD_URL=http://localhost:3000/mem0/ui

# ------------------------------------------------------------------------------
# 4. Ollama & Inference Engine
# ------------------------------------------------------------------------------
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=4
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama
MEM0_DEFAULT_LLM_MODEL=qwen2.5:7b
MEM0_DEFAULT_EMBEDDER_MODEL=bge-m3
MEM0_DEFAULT_EMBEDDER_DIMS=1024

# ------------------------------------------------------------------------------
# 5. Telemetry & Retention
# ------------------------------------------------------------------------------
MEM0_TELEMETRY=false
REQUEST_LOG_RETENTION_DAYS=30
