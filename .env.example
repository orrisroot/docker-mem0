# ==============================================================================
# Mem0 Self-Hosted Configuration (.env)
# NOTE: All secrets must be stored here and NOT committed to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL with pgvector)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=8432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_COLLECTION_NAME=memories
APP_DB_NAME=mem0_app

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=your_secure_jwt_secret_here
ADMIN_API_KEY=
AUTH_DISABLED=false

# ------------------------------------------------------------------------------
# 3. Ports & Service URLs
# ------------------------------------------------------------------------------
MEM0_PORT=8888
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000
DASHBOARD_API_URL=http://localhost:8888
INSTANCE_NAME=Mem0

# ------------------------------------------------------------------------------
# 4. LLM & Embedder Configuration
# ------------------------------------------------------------------------------
# --- Option A: Bundled Ollama Service (Default) ---
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=4
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama
MEM0_DEFAULT_LLM_MODEL=qwen2.5:7b
MEM0_DEFAULT_EMBEDDER_MODEL=bge-m3

# --- Option B: External / Cloud OpenAI API ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-proj-your-key-here
# MEM0_DEFAULT_LLM_MODEL=gpt-4o-mini
# MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 5. Telemetry & Retention
# ------------------------------------------------------------------------------
MEM0_TELEMETRY=false
REQUEST_LOG_RETENTION_DAYS=30
MEM0_DEFAULT_EMBEDDER_DIMS=1024
